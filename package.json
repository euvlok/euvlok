{
  "name": "@euvlok/workspace",
  "private": true,
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    ".github/actions/build-nix-flake-target",
    ".github/renovate",
    ".github/scripts",
    "packages/catppuccin-userstyles"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "typescript": "7.1.0-beta"
  },
  "trustedDependencies": [
    "re2"
  ],
  "scripts": {
    "check": "bun run --workspaces --if-present check",
    "validate:renovate": "bun run --cwd .github/renovate validate"
  }
}
