{
  "name": "@euvlok/workspace",
  "private": true,
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "bun@1.4.5",
  "workspaces": [
    ".github/renovate",
    ".github/scripts",
    "packages/catppuccin-userstyles"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "prettier": "3.10.1",
    "typescript": "7.1.0-beta"
  },
  "trustedDependencies": [
    "re2"
  ],
  "scripts": {
    "check": "bun run --workspaces --if-present check",
    "validate:renovate": "bun run --cwd .github/renovate validate"
  }
}
