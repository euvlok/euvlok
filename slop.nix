      config = lib.modules.mkIf config.euvlok.home.vscode.enable {
        programs.vscode.profiles.default.userSettings.chat.disableAIFeatures = true;
      };
    };
    # kill the AI launcher feature
    #
    # Find the app. Open the app. Shut the fuck up. I hate having a synthetic
    # thought partner wedged between the keyboard and a calculator. Locating an
    # application does not need a conversation or a subscription pitch
    #
    # I want the AI button gone. Leave the space empty. Stop asking whether I
    # want to try it now. I already switched the fucking thing off. Let the
    # feature die thoroughly enough that its documentation becomes a broken link
    raycast = { config, ... }: {
      programs.raycast.configuration.settings = {
        disableAi = true;
        appAliases = [
          {
            names = [ "ChatGPT" ];
            alias = "codex";
            fallbackPath = "${config.home.homeDirectory}/${config.targets.darwin.copyApps.directory}/ChatGPT.app";
          }
        ];
      };
    };
    # pick which fucking subscription deserves an obituary
    #
    # Provider, model, effort, context, credentials. Another administrative
    # chore for the product selling effortless work. I hate the little
    # priesthood around getting a dependable answer. The model picker is another
    # menu I now have to understand before finding out the answer needs checking
    # anyway
    #
    # Setup is work. Checking is work. Repair is work. Put the whole wasted
    # afternoon on the fucking bill. I want the subscription cancelled when its
    # promised saving depends on pretending all of that was free. Let the
    # replacement pitch die under its own timesheet
    personal =
      {
        config,
        lib,
        osConfig ? null,
        pkgs,
        ...
      }:
      let
        inherit (codexLib { inherit config lib; }) configDir;
        models = {
          subscribed = {
            inherit (codexSettings) model;
            enable_thinking = true;
            effort = codexSettings.model_reasoning_effort;
            provider = "openai-subscribed";
          };
          openrouter = {
            model = "deepseek/deepseek-v4-pro";
            provider = "openrouter";
          };
        };
        acpServer = command: args: {
          type = "custom";
          inherit command args;
          env.CODEX_HOME = configDir;
        };
        codexAcpOpenrouter = pkgs.writeShellApplication {
          name = "codex-acp-openrouter";
          runtimeInputs = [ pkgs.codex-acp ];
          text = ''
            set -a
            # shellcheck disable=SC1091
            . ${lib.strings.escapeShellArg config.sops.templates."codex-openrouter.env".path}
            set +a

            exec codex-acp "$@"
          '';
        };

        openrouterSettings = {
          model_provider = models.openrouter.provider;
          model = models.openrouter.model;
          model_catalog_json = "${configDir}/openrouter-model-catalog.json";
          model_reasoning_effort = "high";
          model_context_window = 1000000;
          model_auto_compact_token_limit = 950000;
          model_supports_reasoning_summaries = false;
          service_tier = "fast";
        };
        # JSON scalar literals encode the strings, integers, and booleans
        # used by these TOML overrides
        openrouterArgs =
          lib.cli.toCommandLine
            (_: {
              option = "-c";
              sep = null;
              explicitBool = true;
            })
            {
              c = lib.attrsets.mapAttrsToList (lib.generators.mkKeyValueDefault {
                mkValueString = builtins.toJSON;
              } "=") openrouterSettings;
            };
      in

      {
        config = lib.modules.mkMerge [
          (lib.modules.mkIf config.euvlok.home.codex.enable {
            programs.ghostty.settings.font-family = "Hack Nerd Font Mono";

            programs.codex.settings = {
              apps = lib.modules.mkIf config.euvlok.home.codex.desktop.enable {
                connector_76869538009648d5b282a4bb21c3d157.enabled = true; # GitHub
                connector_0c9786b2f41f41558056126bdb46c9bd.enabled = true; # GitLab
              };
            };
          })
          {
            programs.zed-editor = {
              enableMcpIntegration = true;
              extraPackages = [ pkgs.codex-acp ];
              extensions = [
                "mcp-server-context7"
                "mcp-server-github"
              ];
              userSettings = {
                agent = {
                  dock = "right";
                  model_parameters = [ ];
                  sidebar_side = "right";
                };

                agent_servers = {
                  # cline = {
                  #   type = "custom";
                  #   command = lib.meta.getExe' pkgs.eupkgs.cline-ai "cline";
                  #   args = [ "--acp" ];
                  #   env = { };
                  # };

                  "codex-acp" = acpServer "codex-acp" [ ];
                };

                context_servers = {
                  "mcp-server-context7".settings = { };
                  "mcp-server-github".settings = { };
                  openaiDeveloperDocs.url = "https://developers.openai.com/mcp";
                };

                disable_ai = false;
                edit_predictions.provider = "zed";
                show_edit_predictions = false;
              };
            };
          }
          (lib.modules.mkIf (osConfig != null && osConfig.networking.hostName == "unsigned-int32") {
            sops.secrets.openrouter_api_key = { };

            sops.templates."codex-openrouter.env".content = ''
              OPENROUTER_API_KEY=${config.sops.placeholder.openrouter_api_key}
            '';

            programs.zed-editor = {
              extraPackages = [ codexAcpOpenrouter ];

              userSettings = {
                agent = {
                  default_model = models.subscribed;
                  favorite_models = [
                    models.subscribed
                    models.openrouter
                  ];
                };

                agent_servers.codex_openrouter = acpServer "codex-acp-openrouter" openrouterArgs;
              };
            };
          })
        ];
      };
    codex = codexEnabled;
    # the same fucking corpse on every machine
    #
    # One machine wasn't enough. The same unwanted paragraph gets another
    # address and somebody calls it adoption. I hate the assumption that
    # spreading the fucking product proves it deserved to exist
    #
    # The network can move the bytes. It cannot supply a reason to read them. I
    # want the rollout cancelled before the cleanup gets sold as another
    # service. A dead product mirrored across five hosts is still a dead
    # product. The deployment can fail without becoming somebody else's
    # ecosystem
    hosts = {
      unsignedInt8 = { pkgs, ... }: {
        imports = [ codexEnabled ];
        home.packages = [ pkgs.chatgpt ];
      };
      faputa = { pkgs, ... }: {
        imports = [ codexEnabled ];
        home.packages = [
          pkgs.chatgpt
          pkgs.eupkgs.opencode
        ];
      };
      linuxProductivity = { pkgs, ... }: {
        home.packages = [
          pkgs.unstable.gImageReader
          pkgs.unstable.whisper-cpp
        ];
      };
      unsignedInt32 = { codexDesktopModule }: { config, ... }: {
        imports = [
          codexDesktopModule
          codexEnabled
        ];
        sops.secrets.context7_api_key = { };
        programs.codexDesktopLinux = {
          enable = true;
          computerUseUi.enable = true;
          remoteMobileControl.enable = true;
          linuxFeatures = [
            "appshots"
            "codex-micro"
            "pet-overlay"
            "tray-usage"
            "ui-tweaks"
            "read-aloud"
          ];
          cliPackage = config.euvlok.home.codex.package;
        };
      };
    };
