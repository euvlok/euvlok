      inherit (codexLib { inherit config lib; }) mkDefaults settings;
      servers =
        lib.attrsets.optionalAttrs (
          config.programs.codex.enableMcpIntegration && config.programs.mcp.enable
        ) config.programs.mcp.servers
        // (settings.mcp_servers or { });
      policies = {
        safe = {
          server = {
            default_tools_approval_mode = "prompt";
          };
          settings = {
            approval_policy = "on-request";
            approvals_reviewer = "user";
            default_permissions = ":workspace";
            apps._default.default_tools_approval_mode = "writes";
          };
        };
        review = {
          server = {
            enabled = false;
          };
          settings = {
            approval_policy = "never";
            default_permissions = ":read-only";
            apps._default.enabled = false;
            features.apps = false;
          };
        };
      };
    in
    {
      config = lib.modules.mkIf cfg.enable {
        programs.codex.profiles = lib.attrsets.mapAttrs (
          _: policy:
          mkDefaults (
            policy.settings
            // {
              web_search = "cached";
              mcp_servers = lib.attrsets.mapAttrs (_: _: policy.server) servers;
              plugins."unified-computer-use@openai-bundled".mcp_servers.cua_repl = policy.server;
            }
          )
        ) policies;
      };
    };
  writableConfig =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      cfg = config.euvlok.home.codex;
      inherit (codexLib { inherit config lib; }) configDir configKeyDir;
      # Home Manager merges the main config when mutableSettings is enabled
      # Profiles still need writable copies for app-server config/batchWrite
      configFileKeys =
        lib.attrsets.mapAttrs' (
          name: _: lib.attrsets.nameValuePair "${configKeyDir}/${name}.config.toml" null
        ) config.programs.codex.profiles
        // lib.attrsets.optionalAttrs (!config.programs.codex.mutableSettings) {
          "${configKeyDir}/config.toml" = null;
        };
      configFiles = lib.attrsets.filterAttrs (_: file: file.enable) (
        builtins.intersectAttrs configFileKeys config.home.file
      );
      writeConfig = pkgs.writeShellApplication {
        name = "codex-write-config";
        runtimeInputs = [ pkgs.coreutils ];
        text = ''
          destination=$2
          candidate=$(mktemp -- "$destination.XXXXXX")
          trap 'rm -f -- "$candidate"' EXIT
          install -m 600 -- "$1" "$candidate"
          mv -fT -- "$candidate" "$destination"
        '';
      };
      copyConfig =
        file:
        let
          source = lib.escapeShellArg (toString file.source);
          destination = lib.escapeShellArg (
            if lib.strings.hasPrefix "/" file.target then
              file.target
            else
              "${config.home.homeDirectory}/${file.target}"
          );
        in
        ''
          run ${lib.getExe writeConfig} ${source} ${destination}
        '';
    in
    {
      # The pinned Home Manager module uses /<relative XDG path> as file keys
      # Correct their default targets for configs, skills, hooks, and plugins
      options.home.file = lib.options.mkOption {
        type = lib.types.attrsOf (
          lib.types.submodule (
            { name, ... }:
            {
              config = lib.modules.mkIf cfg.enable {
                # Beat Home Manager's mkDefault target while allowing explicit
                # targets to win with their normal priority of 100
                target = lib.modules.mkIf (
                  config.home.preferXdgDirectories && lib.strings.hasPrefix "${configKeyDir}/" name
                ) (lib.modules.mkOverride 900 "${configDir}/${lib.strings.removePrefix "${configKeyDir}/" name}");
                force = lib.modules.mkIf (builtins.hasAttr name configFileKeys) (lib.modules.mkDefault true);
              };
            }
          )
        );
      };

      config = lib.modules.mkIf cfg.enable {
        home.activation.codexWritableConfig = lib.hm.dag.entryAfter [
          "linkGeneration"
        ] (lib.strings.concatMapStrings copyConfig (builtins.attrValues configFiles));
      };
    };
