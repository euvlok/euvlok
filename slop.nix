        sha256 = "sha256-OYFD0NGp7DS1Gq95X9xc+zKc1g0cjp07zP478oSKjjk=";
        meta.mozPermissions = [ "storage" ];
      };
    };
  };
in
{
  packages.chatgpt =
    {
      lib,
      stdenvNoCC,
      callPackage,
      path,
      fetchurl,
      rpmextract,
      buildFHSEnv,
      cacert,
      glib-networking,
      dconf,
      gdk-pixbuf,
      nix-update-script,
      writeShellApplication,
      curl,
      python315,
    }:
    let
      version = "26.1002.52244";
      sources = {
        x86_64-linux = {
          arch = "x86_64";
          hash = "sha256-l483ILN5ErEtLePR/Z5MVrE1MSRHzahR7znMOrpHRhg=";
        };
        aarch64-linux = {
          arch = "aarch64";
          hash = "sha256-F3p4jpX/NB+e2KTpto2PWbw3FnX4fYY6IfkV378Smvk=";
        };
      };
      fetchSource =
        system:
        let
          source = sources.${system};
        in
        fetchurl {
          url = "https://persistent.oaistatic.com/codex-app-prod/linux/rpm/${source.arch}/chatgpt-${version}-1.${source.arch}.rpm";
          inherit (source) hash;
        };
      payload = stdenvNoCC.mkDerivation {
        pname = "chatgpt-unwrapped";
        inherit version;
        src = fetchSource stdenvNoCC.hostPlatform.system;
        nativeBuildInputs = [ rpmextract ];
        sourceRoot = ".";
        unpackPhase = ''
          runHook preUnpack
          rpmextract "$src"
          runHook postUnpack
        '';
        dontBuild = true;
        # Keep the vendor's ELF interpreters, resources, and native modules
        # together; the FHS environment supplies their runtime dependencies
        dontFixup = true;
        installPhase = ''
          runHook preInstall
          mkdir -p "$out"
          cp -a usr/bin usr/lib usr/share "$out/"
          runHook postInstall
        '';
        meta = {
          license = lib.licenses.unfree;
          platforms = lib.attrsets.attrNames sources;
        };
        passthru = { inherit updateSources; };
      };
      # Refresh both RPM hashes with native fetchers, including unchanged
      # versions, without requiring a builder for the other architecture
      updateSources = lib.attrsets.mapAttrs (
        system: _:
        payload.overrideAttrs {
          src = fetchSource system;
        }
      ) sources;
      # Reuse Nixpkgs' synchronized writable plugin cache inside the FHS
      # environment without patching the vendor's binaries or resource tree
      pluginLauncher = callPackage (path + "/pkgs/by-name/ch/chatgpt/launcher.nix") { };
      fhsArgs = {
        inherit version;
        multiArch = false;
        # Detached windows and child services must survive their launcher
        dieWithParent = false;
        targetPkgs =
          pkgs:
          [ payload ]
          ++ (with pkgs; [
            # ChatGPT and its Chromium runtime, including dlopen dependencies
            alsa-lib
            at-spi2-core
            cairo
            cups
            dbus
            expat
            fontconfig
            freetype
            gdk-pixbuf
            glib
            gtk3
            libcanberra-gtk3
            libdrm
            libgbm
            libglvnd
            libnotify
            libpulseaudio
            libsecret
            libva
            libxcb
            libxkbcommon
            nspr
            nss
            pango
            pipewire
            mesa
            systemdLibs
            vulkan-loader
            wayland
            libx11
            libxcomposite
            libxdamage
            libxext
            libxfixes
            libxrandr

            # Chromium ships optional shims for both Qt desktop versions
            qt5.qtbase
            qt6.qtbase

            # USB/HID addons and the remote-control device-key addon
            libusb1
            openssl
            tpm2-tss

            # Desktop integration, HTTPS, and subprocesses launched by Work
            cacert
            dconf
            glib-networking
            shared-mime-info
            xdg-utils
            zlib
          ]);
        profile = ''
          export SSL_CERT_FILE="''${SSL_CERT_FILE:-${cacert}/etc/ssl/certs/ca-bundle.crt}"
          export NIX_SSL_CERT_FILE="''${NIX_SSL_CERT_FILE:-$SSL_CERT_FILE}"
          export NODE_EXTRA_CA_CERTS="''${NODE_EXTRA_CA_CERTS:-$SSL_CERT_FILE}"
          export GIO_EXTRA_MODULES="${glib-networking}/lib/gio/modules:${lib.attrsets.getLib dconf}/lib/gio/modules''${GIO_EXTRA_MODULES:+:$GIO_EXTRA_MODULES}"
          export GDK_PIXBUF_MODULE_FILE="''${GDK_PIXBUF_MODULE_FILE:-${gdk-pixbuf}/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache}"
          export GTK_PATH="/usr/lib/gtk-3.0''${GTK_PATH:+:$GTK_PATH}"
          # Other Linux distributions lack NixOS's graphics driver directory
          if [[ ! -d /run/opengl-driver/lib ]]; then
            export GBM_BACKENDS_PATH="''${GBM_BACKENDS_PATH:-/usr/lib/gbm}"
            export LIBGL_DRIVERS_PATH="''${LIBGL_DRIVERS_PATH:-/usr/lib/dri}"
            export LIBVA_DRIVERS_PATH="''${LIBVA_DRIVERS_PATH:-/usr/lib/dri}"
          fi
        '';
      };
      node = buildFHSEnv (
        fhsArgs
        // {
          pname = "chatgpt-node";
          runScript = "/usr/lib/chatgpt/resources/cua_node/bin/node";
        }
      );
      extensionHost = buildFHSEnv (
        fhsArgs
        // {
          pname = "chatgpt-extension-host";
          runScript = "${
            writeShellApplication {
              name = "chatgpt-extension-host-exec";
              text = ''exec "$@"'';
            }
          }/bin/chatgpt-extension-host-exec";
        }
      );
      updater = writeShellApplication {
        name = "chatgpt-update";
        runtimeInputs = [ curl ];
        text = ''
          export NIXPKGS_ALLOW_UNFREE=1
          version=$(${lib.meta.getExe python315} - <<'PY'
          import gzip
          import subprocess
          import xml.etree.ElementTree as ET
          from io import BytesIO


          # urllib requests are rejected by this endpoint, so retain curl
          def get(url):
              return subprocess.check_output(
                  ["curl", "--fail", "--silent", "--show-error", "--location", url]
              )


          versions = []
          repo_ns = {"r": "http://linux.duke.edu/metadata/repo"}
          pkg_ns = {"p": "http://linux.duke.edu/metadata/common"}
          for arch in ("x86_64", "aarch64"):
              base = f"https://persistent.oaistatic.com/codex-app-prod/linux/rpm/{arch}/"
              index = ET.fromstring(get(base + "repodata/repomd.xml"))
              location = index.find("r:data[@type='primary']/r:location", repo_ns)
              # Parse incrementally without a full decompressed byte buffer
              with gzip.GzipFile(
                  fileobj=BytesIO(get(base + location.attrib["href"]))
              ) as metadata:
                  packages = ET.parse(metadata).getroot()
              releases = [
                  p.find("p:version", pkg_ns).attrib["ver"]
                  for p in packages
                  if p.findtext("p:name", namespaces=pkg_ns) == "chatgpt"
              ]
              versions.append(max(releases, key=lambda v: tuple(map(int, v.split(".")))))
          if len(set(versions)) != 1:
              raise SystemExit("ChatGPT Linux architectures have different latest versions")
          print(versions[0])
          PY
          )
          exec ${
            lib.strings.escapeShellArgs (nix-update-script {
              attrPath = "chatgpt.unwrapped";
              extraArgs = [
                "--flake"
                "--format"
                "--override-filename=slop.nix"
                "--system=${stdenvNoCC.buildPlatform.system}"
                "--subpackage=updateSources.x86_64-linux"
                "--subpackage=updateSources.aarch64-linux"
              ];
            })
          } --version="$version" "$@"
        '';
      };
    in
    buildFHSEnv (
      fhsArgs
      // {
        pname = "chatgpt";
        runScript = lib.meta.getExe (writeShellApplication {
          name = "chatgpt-fhs-launcher";
          text = ''
            export CHATGPT_EXECUTABLE=/usr/bin/chatgpt
            export CHATGPT_RESOURCES_SOURCE="${payload}/lib/chatgpt/resources"
            export CHATGPT_RESOURCES_CACHE_KEY="${builtins.baseNameOf (toString payload)}"
            exec ${lib.meta.getExe pluginLauncher} "$@"
          '';
        });
        extraInstallCommands = ''
          cp -r ${payload}/share "$out/share"
          substituteInPlace "$out/share/applications/chatgpt.desktop" \
            --replace-fail 'Exec=chatgpt %U' "Exec=$out/bin/chatgpt %U"

          # Home Manager launches Node REPL from this resource path outside
          # ChatGPT, so its dynamically linked Node also needs an FHS entry
          cp -rs ${payload}/lib "$out/lib"
          chmod u+w "$out/lib/chatgpt/resources/cua_node/bin"
          rm "$out/lib/chatgpt/resources/cua_node/bin/node"
          ln -s ${lib.meta.getExe node} "$out/lib/chatgpt/resources/cua_node/bin/node"
        '';
        passthru = {
          unwrapped = payload;
          inherit node extensionHost updateSources;
          updateScript = lib.meta.getExe updater;
        };
        meta = {
          description = "ChatGPT desktop with Work and Codex in an FHS environment";
          homepage = "https://learn.chatgpt.com/docs/linux/linux-app";
          license = lib.licenses.unfree;
          platforms = lib.attrsets.attrNames sources;
          sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
          mainProgram = "chatgpt";
        };
      }
    );
  homeManager = {
    cli = {
      imports = [
        codex
        claudeCode
        opencode
      ];
    };
    catppuccin =
      {
        config,
        lib,
        pkgs,
        ...
      }:
      let
        cfg = config.catppuccin.codex;
        inherit (codexLib { inherit config lib pkgs; }) configDir mkDefaults;
        darkFlavor = if cfg.flavor == "latte" then "frappe" else cfg.flavor;
        palette = lib.trivial.importJSON "${config.catppuccin.sources.palette}/palette.json";
        appearances = {
          Light = {
            flavor = "latte";
            contrast = 45;
          };
          Dark = {
            flavor = darkFlavor;
            contrast = 60;
          };
        };
        desktopTheme =
          colors: contrast:
          let
            accent = colors.${config.catppuccin.accent}.hex;
          in
          {
            inherit accent contrast;
            accentSource = "custom";
            ink = colors.text.hex;
            surface = colors.base.hex;
            opaqueWindows = false;
            semanticColors = {
              diffAdded = colors.green.hex;
              diffRemoved = colors.red.hex;
              skill = accent;
            };
          };
        theme =
          variant:
          "${config.catppuccin.sources.bat}/Catppuccin ${lib.strings.toSentenceCase variant}.tmTheme";
      in
      {
        options.catppuccin.codex = {
          enable = lib.options.mkEnableOption "Catppuccin for Codex" // {
            default = config.catppuccin.autoEnable;
            defaultText = lib.options.literalExpression "config.catppuccin.autoEnable";
          };
          flavor = lib.options.mkOption {
            type = lib.types.enum [
              "latte"
              "frappe"
              "macchiato"
              "mocha"
            ];
            default = config.catppuccin.flavor;
            defaultText = lib.options.literalExpression "config.catppuccin.flavor";
            description = "Catppuccin flavor for Codex";
          };
        };

        config = lib.modules.mkIf (config.catppuccin.enable && cfg.enable && config.programs.codex.enable) {
          home.file = lib.attrsets.mapAttrs' (
            _:
            { flavor, ... }:
            lib.attrsets.nameValuePair "${configDir}/themes/catppuccin-${flavor}.tmTheme" {
              source = theme flavor;
            }
          ) appearances;
          programs.codex.settings = mkDefaults {
            tui.theme = "catppuccin-${cfg.flavor}";
            desktop = lib.attrsets.concatMapAttrs (
              appearance:
              { flavor, contrast }:
              {
                "appearance${appearance}CodeThemeId" = "catppuccin-${flavor}";
                "appearance${appearance}ChromeTheme" = desktopTheme palette.${flavor}.colors contrast;
              }
            ) appearances;
          };
        };
      };
    vscode = { config, lib, ... }: {
      config = lib.modules.mkIf config.euvlok.home.vscode.enable {
        programs.vscode.profiles.default.userSettings.chat.disableAIFeatures = true;
      };
    };
    raycast = _: {
      programs.raycast.configuration.settings = {
        disableAi = true;
        appAliases = [
          {
            names = [ "ChatGPT" ];
            alias = "codex";
            fallbackPath = "/Applications/ChatGPT.app";
          }
        ];
      };
    };
    personal =
      {
        config,
        lib,
        osConfig ? null,
        pkgs,
        ...
      }:
      let
        inherit (codexLib { inherit config lib pkgs; }) configDir;
        astGrepSkillSource = pkgs.fetchFromGitHub {
          owner = "ast-grep";
          repo = "agent-skill";
          rev = "0613dc7f82bbfb3b557380b54726b92f73358460";
          hash = "sha256-HFZVX/UYsct8EMtkczBGJNr9RjjDz77zY6SHS1WlKkc=";
        };
        astGrepSkill = "${astGrepSkillSource}/ast-grep/skills/ast-grep";
        ansibleSkillsSource = pkgs.fetchFromGitHub {
          owner = "leogallego";
          repo = "claude-ansible-skills";
          rev = "2c43de8f4b180342f05f5e670cc7e6e8ae359ec4";
          hash = "sha256-+aiGKrOHoY5i/nsCVvxPq9g6NH6ivYivc8dbKb6BUUg=";
        };
        ansibleSkillNames = [
          "ansible-docs"
          "ansible-good-practices"
          "ansible-new-collection"
          "ansible-new-ee"
          "ansible-new-molecule"
          "ansible-new-role"
          "ansible-zen"
        ];
        ansibleSkills = pkgs.runCommand "ansible-agent-skills" { } (
          lib.concatMapStringsSep "\n" (name: ''
            mkdir -p "$out/${name}"
            cp -R ${ansibleSkillsSource}/${name}/skills/${name}/. "$out/${name}/"
            if [ -d ${ansibleSkillsSource}/${name}/references ]; then
              cp -R ${ansibleSkillsSource}/${name}/references "$out/${name}/references"
            fi
          '') ansibleSkillNames
        );
        models = {
          subscribed = {
            inherit (codexSettings) model;
            enable_thinking = true;
            effort = codexSettings.model_reasoning_effort;
            provider = "openai-subscribed";
          };
          openrouter = {
            model = "deepseek/deepseek-v4-pro";
            provider = "openrouter";
          };
        };
        acpServer = command: args: {
          type = "custom";
          inherit command args;
          env.CODEX_HOME = configDir;
        };
        codexAcpOpenrouter = pkgs.writeShellApplication {
          name = "codex-acp-openrouter";
          runtimeInputs = [ pkgs.codex-acp ];
          text = ''
            set -a
            # shellcheck disable=SC1091
            . ${lib.strings.escapeShellArg config.sops.templates."codex-openrouter.env".path}
            set +a

            exec codex-acp "$@"
          '';
        };

        openrouterSettings = {
          model_provider = models.openrouter.provider;
          model = models.openrouter.model;
          # Unknown model slugs use Codex's built-in metadata fallback
          "model_providers.openrouter.name" = "OpenRouter";
          "model_providers.openrouter.base_url" = "https://openrouter.ai/api/v1";
          "model_providers.openrouter.env_key" = "OPENROUTER_API_KEY";
          "model_providers.openrouter.wire_api" = "responses";
          model_reasoning_effort = "high";
          model_context_window = 1000000;
          model_auto_compact_token_limit = 950000;
          model_supports_reasoning_summaries = false;
          service_tier = "fast";
        };
        # JSON scalar literals encode the strings, integers, and booleans
        # used by these TOML overrides
        openrouterArgs =
          lib.cli.toCommandLine
            (_: {
              option = "-c";
              sep = null;
              explicitBool = true;
            })
            {
              c = lib.attrsets.mapAttrsToList (lib.generators.mkKeyValueDefault {
                mkValueString = lib.strings.toJSON;
              } "=") openrouterSettings;
            };
      in

      {
        imports = [ mcp ];

        config = lib.modules.mkMerge [
          (lib.modules.mkIf config.euvlok.home.codex.enable {
            programs.ghostty.settings.font-family = "Hack Nerd Font Mono";

            home.packages = [ pkgs.unstable.glab ];
            programs.codex.skills.ast-grep = astGrepSkill;
            programs.codex.skills.glab = "${pkgs.unstable.glab.src}/internal/commands/skills/bundled/assets/glab";
            programs.codex.skills.forgejo = ./slop/skills/forgejo;

            home.file = lib.genAttrs (map (name: ".agents/skills/${name}") ansibleSkillNames) (path: {
              source = "${ansibleSkills}/${builtins.baseNameOf path}";
            });

            programs.codex.settings = {
              desktop.git-branch-prefix = "ashuramaruzxc";
              apps = lib.modules.mkIf config.euvlok.home.codex.desktop.enable {
                connector_76869538009648d5b282a4bb21c3d157.enabled = true; # GitHub
                connector_0c9786b2f41f41558056126bdb46c9bd.enabled = true; # GitLab
              };
            };
          })
          (lib.modules.mkIf config.euvlok.home.claude-code.enable {
            programs.claude-code.skills.ast-grep = astGrepSkill;
            programs.claude-code.skills.forgejo = ./slop/skills/forgejo;
          })
          {
            programs.zed-editor = {
              enableMcpIntegration = true;
              extraPackages = [ pkgs.codex-acp ];
              extensions = [
                "mcp-server-context7"
                "mcp-server-github"
              ];
              userSettings = {
                agent = {
                  dock = "right";
                  model_parameters = [ ];
                  sidebar_side = "right";
                };

                agent_servers = {
                  "codex-acp" = acpServer "codex-acp" [ ];
                };

                context_servers = {
                  "mcp-server-context7".settings = { };
                  "mcp-server-github".settings = { };
                  openaiDeveloperDocs.url = "https://developers.openai.com/mcp";
                };

                disable_ai = false;
                edit_predictions.provider = "zed";
                show_edit_predictions = false;
              };
            };
          }
          (lib.modules.mkIf (osConfig != null && osConfig.networking.hostName == "unsigned-int32") {
            sops.secrets.openrouter_api_key = { };

            sops.templates."codex-openrouter.env".content = ''
              OPENROUTER_API_KEY=${config.sops.placeholder.openrouter_api_key}
            '';

            programs.zed-editor = {
              extraPackages = [ codexAcpOpenrouter ];

              userSettings = {
                agent = {
                  default_model = models.subscribed;
                  favorite_models = [
                    models.subscribed
                    models.openrouter
                  ];
                };

                agent_servers.codex_openrouter = acpServer "codex-acp-openrouter" openrouterArgs;
              };
            };
          })
        ];
      };
    codex = codexEnabled;
    claude-code = claudeCodeEnabled;
    hosts = {
      unsignedInt8 = _: {
        imports = [
          codexEnabled
          claudeCodeEnabled
        ];
        sops.secrets = {
          context7_api_key = { };
          gitlab_simsoft = { };
          forjego_tenjin = { };
        };
        programs.ai.omp.settings.modelRoles.default = "openai-codex/gpt-6.1-sol";
      };
      faputa = { pkgs, ... }: {
        imports = [
          codexEnabled
          claudeCodeEnabled
        ];
        home.packages = [
          pkgs.chatgpt
          pkgs.eupkgs.opencode
        ];
      };
      unsignedInt32 = { codexDesktopModule }: { config, ... }: {
        imports = [
          codexDesktopModule
          codexEnabled
          claudeCodeEnabled
        ];
        sops.secrets.context7_api_key = { };
        programs.codexDesktopLinux = {
          enable = true;
          computerUseUi.enable = true;
          remoteMobileControl.enable = true;
          linuxFeatures = [
            "appshots"
            "codex-micro"
            "pet-overlay"
            "tray-usage"
            "ui-tweaks"
            "read-aloud"
          ];
          cliPackage = config.euvlok.home.codex.package;
        };
      };
    };
  };
  darwin =
    { euvlokInputs }:
    { ... }:
    {
      imports = [ euvlokInputs.pared.darwinModules.default ];

      programs.pared = {
        enable = true;
        defaultState = false;
      };
    };
  firefoxExtensions =
    { buildFirefoxXpiAddon, lib, ... }:
    lib.attrsets.mapAttrs (
      id: addon:
      buildFirefoxXpiAddon (
        addon.package
        // {
          pname = id;
          meta = addon.package.meta // {
            platforms = lib.systems.doubles.all;
          };
        }
      )
    ) firefoxAddons;
  firefoxSources = [ firefoxSource ];
}
