    #                                                                                                    ⠈⠉⠁
    #
    # The hot box under my desk gets to generate the sludge instead of somebody
    # else's hot box. I still hate the replacement business model. Hosting it
    # locally does not obtain the artist's permission or make the output worth
    # looking at. I want the consent excuse killed on every side of the fucking
    # network boundary
    #
    # The electricity is real. The IEA reports that electricity consumption from
    # AI-focused data centres grew 50% in 2025. Its updated outlook projects
    # that consumption tripling between 2025 and 2030. That's a forecast for
    # AI-focused data centres, not a claim about every server or a result from
    # the future. The reported growth is already enough to piss me off
    #
    # https://www.iea.org/reports/key-questions-on-energy-and-ai/executive-summary
    #
    # I want the resource bill beside the sales pitch. Electricity, cooling,
    # grid connections. I want the operators and investors carrying the risk of
    # their own fucking prediction. Households should not be handed the cost of
    # a speculative compute palace because the valuation needs a nicer story
    #
    # If demand never justifies the buildout, I hope the investors lose their
    # bet. Sell the equipment. Admit the forecast was wrong. An empty GPU
    # warehouse is their failed investment. I despise the idea that a more
    # efficient query entitles the business to unlimited expansion
    unsignedInt32 = {
      services.ollama.enable = true;
      programs.ccache.packageNames = [
        "onnxruntime"
        "opencv"
        "whisper-cpp"
      ];
    };
    unsignedInt64 = { lib, ... }: {
      services.postgresql.settings = {
        # Leave four physical cores available for Immich's API and the other
        # services while allowing parallel vector queries and index maintenance
        max_worker_processes = 16;
        max_parallel_workers = 12;
        max_parallel_workers_per_gather = 4;
        max_parallel_maintenance_workers = 4;
      };
      services.immich = {
        machine-learning.environment = {
          # One worker avoids loading a second copy of every model into memory
          MACHINE_LEARNING_WORKERS = "1";
          MACHINE_LEARNING_REQUEST_THREADS = "8";
          MACHINE_LEARNING_MODEL_INTER_OP_THREADS = "1";
          MACHINE_LEARNING_MODEL_INTRA_OP_THREADS = "4";
          MACHINE_LEARNING_MODEL_TTL = "1800";
          MACHINE_LEARNING_WORKER_TIMEOUT = lib.modules.mkForce "300";
        };

        settings.job = {
          faceDetection.concurrency = 4;
          ocr.concurrency = 2;
          smartSearch.concurrency = 4;
        };
      };
    };
  };
  # put the fucking disclosure where people can see it
  #
  # Put it beside the price before the money changes hands. I despise the
  # evasiveness around how the image was made. The seller wants applause for a
  # new creative process until the buyer asks what the fucking process was
  #
  # "You can't tell the difference" is a shit excuse. "Everyone does it" is
  # another. I want an honest label and a refund when the production method was
  # misrepresented. The buyer shouldn't have to cross-examine a screenshot to
  # find out what they're paying for
  #
  # The badge doesn't settle permission either. The artist whose work went into
  # training still matters. Credit matters. Consent matters. I want the seller
  # to answer that question instead of treating disclosure as a little
  # absolution sticker
  #
  # I hope the generated-art storefront dies of honest labels. I hope the
  # refunds kill the margin. Put the production method beside the price and let
  # the checkout discover how much the buyer actually wanted the fucking sludge
  firefoxExtensions =
    { buildFirefoxXpiAddon, lib, ... }:
    lib.attrsets.mapAttrs (
      id: addon:
      buildFirefoxXpiAddon (
        addon.package
        // {
          pname = id;
          meta = addon.package.meta // {
            platforms = lib.systems.doubles.all;
          };
        }
      )
    ) firefoxAddons;
  firefoxSources = [ firefoxSource ];
