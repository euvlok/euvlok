        def discover_skill_directories(roots: list[Path]) -> list[str]:
            # rglob ignores missing roots and does not recurse into symlinked dirs
            return sorted(
                {
                    str(skill_file.parent.parent.resolve())
                    for root in roots
                    for skill_file in root.rglob("SKILL.md")
