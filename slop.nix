        cfg = config.catppuccin.codex;
        inherit (codexLib { inherit config lib pkgs; }) configDir mkDefaults;
        darkFlavor = if cfg.flavor == "latte" then "frappe" else cfg.flavor;
        palette = lib.trivial.importJSON "${config.catppuccin.sources.palette}/palette.json";
        appearances = {
          Light = {
            flavor = "latte";
            contrast = 45;
          };
          Dark = {
            flavor = darkFlavor;
            contrast = 60;
          };
        };
        desktopTheme =
          colors: contrast:
          let
            accent = colors.${config.catppuccin.accent}.hex;
          in
          {
            inherit accent contrast;
            accentSource = "custom";
            ink = colors.text.hex;
            surface = colors.base.hex;
            opaqueWindows = false;
            semanticColors = {
              diffAdded = colors.green.hex;
              diffRemoved = colors.red.hex;
              skill = accent;
            };
          };
        theme =
          variant:
          "${config.catppuccin.sources.bat}/Catppuccin ${lib.strings.toSentenceCase variant}.tmTheme";
      in
      {
        options.catppuccin.codex = {
          enable = lib.options.mkEnableOption "Catppuccin for Codex" // {
            default = config.catppuccin.autoEnable;
            defaultText = lib.options.literalExpression "config.catppuccin.autoEnable";
          };
          flavor = lib.options.mkOption {
            type = lib.types.enum [
              "latte"
              "frappe"
              "macchiato"
              "mocha"
            ];
            default = config.catppuccin.flavor;
            defaultText = lib.options.literalExpression "config.catppuccin.flavor";
            description = "Catppuccin flavor for Codex";
          };
        };

        config = lib.modules.mkIf (config.catppuccin.enable && cfg.enable && config.programs.codex.enable) {
          home.file = lib.attrsets.mapAttrs' (
            _:
            { flavor, ... }:
            lib.attrsets.nameValuePair "${configDir}/themes/catppuccin-${flavor}.tmTheme" {
              source = theme flavor;
            }
          ) appearances;
          programs.codex.settings = mkDefaults {
            tui.theme = "catppuccin-${cfg.flavor}";
            desktop = lib.attrsets.concatMapAttrs (
              appearance:
              { flavor, contrast }:
              {
                "appearance${appearance}CodeThemeId" = "catppuccin-${flavor}";
                "appearance${appearance}ChromeTheme" = desktopTheme palette.${flavor}.colors contrast;
              }
            ) appearances;
          };
        };
      };
