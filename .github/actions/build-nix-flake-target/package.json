{
  "name": "@euvlok/build-nix-flake-target",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --target=bun --minify --outfile=dist/build.js build.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format:check": "prettier --check build.ts build.test.ts package.json tsconfig.json",
    "lint": "biome lint --error-on-warnings build.ts build.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "entities": "8.0.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
