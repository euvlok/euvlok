{
  "name": "@euvlok/build-nix-flake-target",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --target=bun --minify --outfile=dist/build.js build.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format:check": "prettier --check build.ts build.test.ts triage.ts package.json tsconfig.json ../../renovate/postUpgrade.ts",
    "lint": "biome lint --error-on-warnings build.ts build.test.ts triage.ts ../../renovate/postUpgrade.ts",
    "triage": "bun run triage.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@typesafe-ai/sdk": "0.6.0",
    "entities": "8.1.0",
    "valibot": "1.5.0"
  }
}
