@@ -21,6 +21,7 @@ uninstall_link() {
 #   4: color - Color scheme suffix
 #   5: size  - Size variant suffix
 #   6: ctype - Background scheme suffix
+#   7: tweaks_tag - Active tweaks tag suffix
 uninstall_theme_folder() {
     local dest="${1}"
     local name="${2}"
@@ -28,15 +29,18 @@ uninstall_theme_folder() {
     local color="${4}"
     local size="${5}"
     local ctype="${6}"
